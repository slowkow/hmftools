#!/usr/bin/env bash
# `purple` as oncoanalyser calls the Java tool, run by purple-rs: JVM options are dropped (purple-rs also
# ignores them) and the jar's default main class, PurpleApplication, runs. oncoanalyser passes
# `-circos $(which circos)`; the image has no Circos, so that is `-circos` with no value. Either way it becomes
# `-circos_native`: purple-rs writes the Circos files and draws circos.png and input.png itself, as it draws
# the R plots (hmf-plot-rs). -java_compat or PURPLE_JAVA_COMPAT=1 selects Java's behaviour.
set -euo pipefail
args=()
skip_value=0
for a in "$@"; do
    if [ "$skip_value" = 1 ]; then
        skip_value=0
        [[ "$a" != -* ]] && continue
    fi
    case "$a" in
        -Xmx*|-Xms*|-Xss*|-XX:*|-D*=*) continue ;;
        com.hartwig.hmftools.purple.PurpleApplication) continue ;;
        com.hartwig.*) echo "purple (Rust port): main class $a is not ported" >&2; exit 2 ;;
        -circos) args+=("-circos_native"); skip_value=1; continue ;;
    esac
    args+=("$a")
done
exec purple-rs ${args[@]+"${args[@]}"}
