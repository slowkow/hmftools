#!/usr/bin/env bash
# `isofox` as oncoanalyser calls the Java tool (ISOFOX_QUANTIFICATION, NEO_ANNOTATE_FUSIONS), run by isofox-rs:
# JVM options are dropped. isofox-rs reproduces ISOFOX 2.1 (for bwa-mem3 + TARS RNA BAMs) and 2.0.1 (for STAR BAMs):
# `-isofox_version 2.0.1|2.1`, else ISOFOX_VERSION, else 2.0.1 when the BAM header has a STAR @PG line, else 2.1.
# -java_compat selects Java's behaviour.
set -euo pipefail
args=()
for a in "$@"; do
    case "$a" in
        -Xmx*|-Xms*|-Xss*|-XX:*|-D*=*) ;;
        com.hartwig.hmftools.isofox.Isofox) ;;
        com.hartwig.*) echo "isofox (Rust port): main class $a is not ported" >&2; exit 2 ;;
        *) args+=("$a") ;;
    esac
done
exec isofox-rs ${args[@]+"${args[@]}"}
