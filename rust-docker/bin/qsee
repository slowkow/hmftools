#!/usr/bin/env bash
# `qsee` as oncoanalyser calls the Java tool, run by qsee-rs: JVM options are dropped; qsee-rs takes the Java main
# classes itself (QseeApplication, the default, and the jar's other entry points). qsee-rs draws the visual report
# (<tumor>.qsee.vis.report.pdf and .png) natively, as the jar's R script does, so no R is needed; `-skip_plot` is
# passed on only when the caller gives it. -java_compat or QSEE_JAVA_COMPAT=1 selects Java's behaviour.
set -euo pipefail
args=()
for a in "$@"; do
    case "$a" in
        -Xmx*|-Xms*|-Xss*|-XX:*|-D*=*) ;;
        *) args+=("$a") ;;
    esac
done
exec qsee-rs ${args[@]+"${args[@]}"}
